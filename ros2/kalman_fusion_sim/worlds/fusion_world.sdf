<?xml version="1.0" ?>
<!--
  fusion_world.sdf — modern gz sim (Gazebo Harmonic / Ionic) world.

  Contains:
    * ground plane + a directional (sun) light
    * a minimal differential-drive robot ("fusion_bot") carrying
        - an IMU sensor          -> gz topic  /imu
        - an odometry publisher  -> gz topic  /model/fusion_bot/odometry
    * system plugins: Physics, SceneBroadcaster, UserCommands, Sensors,
      Imu, DiffDrive, OdometryPublisher

  The gz topics are bridged to the ROS2 topics the kalman_fusion node expects
  (/imu, /position) by ros_gz_bridge — see config/bridge.yaml. Drive the robot
  with, e.g.:
    gz topic -t /model/fusion_bot/cmd_vel -m gz.msgs.Twist \
      -p 'linear:{x:0.5}, angular:{z:0.3}'
-->
<sdf version="1.10">
  <world name="fusion_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="fusion_bot">
      <pose>0 0 0.15 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.10</ixx>
            <iyy>0.15</iyy>
            <izz>0.20</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.3 0.15</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.3 0.15</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>

        <!-- IMU sensor: publishes gz.msgs.IMU on /imu -->
        <sensor name="imu_sensor" type="imu">
          <topic>imu</topic>
          <update_rate>50</update_rate>
          <always_on>true</always_on>
          <imu>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.18 -0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.18 -0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="caster">
        <pose>-0.2 0 -0.1 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <joint name="caster_joint" type="ball">
        <parent>base_link</parent>
        <child>caster</child>
      </joint>

      <!-- Differential drive: subscribes gz.msgs.Twist on cmd_vel -->
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>

      <!-- Odometry publisher: publishes gz.msgs.Odometry on /model/fusion_bot/odometry -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>10</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
