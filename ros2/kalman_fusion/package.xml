<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kalman_fusion</name>
  <version>0.1.0</version>
  <description>
    ROS2 node wrapping the sensor-fusion-lab linear Kalman filter: fuses a
    position topic and an IMU topic into a published fused odometry estimate.
    The estimation core (FusionCore) is pure Python and ROS-free, so it is
    unit-testable without a ROS2 install.
  </description>
  <maintainer email="dev@example.com">sensor-fusion-lab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
